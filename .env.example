# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/phantompay

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

# Lithic (Card Engine)
LITHIC_API_KEY=your_lithic_sandbox_api_key
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
LITHIC_WEBHOOK_SECRET=your_lithic_webhook_secret

# Plaid (Bank Linking)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_sandbox_secret
PLAID_BASE_URL=https://sandbox.plaid.com
PLAID_ENV=sandbox

# Stripe (Billing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# App
APP_NAME=PhantomPay
WEBHOOK_BASE_URL=https://api.phantompay.online
